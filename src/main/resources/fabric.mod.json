{
	"schemaVersion": 1,
	"id": "tameablespider",
	"version": "${version}",
	"name": "TameableSpider",
	"description": "Makes spiders tameable via rotten flesh or spider eye's... so they don't attack you ...",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
